{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "fr",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/lumaa-dev/Safyn",
      "version": {
        "branch": "main",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/unionst/union-toast/",
      "version": {
        "up-to-next-minor-version": "2.1.2",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/the-amber-team/TextFlowKit",
      "version": {
        "branch": "main",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/The-Amber-Team/DiscogsKit",
      "version": {
        "branch": "main",
      },
    },
  ],
  "files": [
    {
      "kind": "folder",
      "path": "Nafyn",
      "target-membership": [
        "Nafyn",
      ],
      "membership-exceptions": [
        {
          "target": "Nafyn",
          "exclusions": [
            "Info.plist",
          ],
        }, {
          "target": "RemoteMediaSessionExtension",
          "inclusions": [
            "Data/Device/DeviceManager.swift",
            "Data/Device/DeviceModels.swift",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "Shared", "target-membership": [ "Nafyn", "NafynWidgetsExtension", "RemoteMediaSessionExtension" ] },
    {
      "kind": "folder",
      "path": "NafynWidgets",
      "target-membership": [
        "NafynWidgetsExtension",
      ],
      "membership-exceptions": [
        {
          "target": "NafynWidgetsExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "NafynNotificationService",
      "target-membership": [
        "NafynNotificationService",
      ],
      "membership-exceptions": [
        {
          "target": "NafynNotificationService",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "RemoteMediaSessionExtension",
      "target-membership": [
        "RemoteMediaSessionExtension",
      ],
      "membership-exceptions": [
        {
          "target": "RemoteMediaSessionExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "/System/Library/Frameworks/WidgetKit.framework", "target-membership": [ "NafynWidgetsExtension/frameworks" ] },
        { "path": "/System/Library/Frameworks/SwiftUI.framework", "target-membership": [ "NafynWidgetsExtension/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Nafyn.app", "id": "000000000000000000000120", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/NafynWidgetsExtension.appex", "id": "B968C4073083277900BB01AB", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Nafyn/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/NafynNotificationService.appex", "id": "B968C4213083277A00BB01AB", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Nafyn/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/RemoteMediaSessionExtension.appex", "id": "B968C4323083277B00BB01AB", "type": "wrapper.extensionkit-extension", "index": false, "target-membership": [ { "build-phase": "Nafyn/copy/Embed ExtensionKit Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "Nafyn",
      "id": "000000000000000100000000",
      "product": "Products/Nafyn.app",
      "product-type": "application",
      "last-swift-migration": "27.0",
      "dependencies": [
        "NafynWidgetsExtension",
        "NafynNotificationService",
        "RemoteMediaSessionExtension",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "copy",
          "name": "Embed ExtensionKit Extensions",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(EXTENSIONS_FOLDER_PATH)",
        },
      ],
      "package-product-members": [
        {
          "package": "DiscogsKit",
          "product-name": "DiscogsKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Safyn",
          "product-name": "Safyn",
