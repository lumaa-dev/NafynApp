    "NAFYN_RELEASE_OUT_BODY" : {
      "comment" : "Push notification text, looked up by the system from the server's loc-key. Args: requests %1$@ requester, %2$@ title, %3$@ artist; releases %1$@ title, %2$@ artist",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ by %2$@ is out now"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ de %2$@ est disponible"
          }
        }
      }
    },
